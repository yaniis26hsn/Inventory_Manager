-- ============================================================

-- ------------------------------------------------------------
-- Création des tables
-- ------------------------------------------------------------
CREATE TABLE Publishers (
  publisherID INT AUTO_INCREMENT PRIMARY KEY,
  publisherName VARCHAR(100) NOT NULL,
  headquartersLocation VARCHAR(100),
  foundationYear INT,
  website VARCHAR(200) UNIQUE
);

CREATE TABLE Authors (
  authorID INT AUTO_INCREMENT PRIMARY KEY,
  authorName VARCHAR(100),
  email VARCHAR(100) UNIQUE,
  age INT,
  country VARCHAR(50)
);

CREATE TABLE Members (
  memberID INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100),
  email VARCHAR(100) UNIQUE,
  phone VARCHAR(20),
  address VARCHAR(200)
);

CREATE TABLE Books (
  ISBN VARCHAR(20) PRIMARY KEY,
  title VARCHAR(25) NOT NULL,
  publisher INT,
  publicationDate DATE,
  genre VARCHAR(50),
  CONSTRAINT fk_books_publisher FOREIGN KEY (publisher) REFERENCES Publishers(publisherID)
);

CREATE TABLE WrittenBy (
  book VARCHAR(20),
  author INT,
  PRIMARY KEY (book, author),
  CONSTRAINT fk_writtenby_book FOREIGN KEY (book) REFERENCES Books(ISBN),
  CONSTRAINT fk_writtenby_author FOREIGN KEY (author) REFERENCES Authors(authorID)
);

CREATE TABLE BookLoans (
  loanID INT AUTO_INCREMENT PRIMARY KEY,
  book VARCHAR(20),
  member INT,
  borrowDate DATE,
  returnDate DATE,
  dueDate DATE,
  CONSTRAINT fk_bookloans_book FOREIGN KEY (book) REFERENCES Books(ISBN),
  CONSTRAINT fk_bookloans_member FOREIGN KEY (member) REFERENCES Members(memberID)
);

