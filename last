-- PARTIE III – Application : Modifications de structure
-- ============================================================

-- 1. Ajouter la colonne rating à Books
ALTER TABLE Books ADD COLUMN rating INT;

-- 2. Supprimer la colonne age de Authors
ALTER TABLE Authors DROP COLUMN age;

-- 3. Augmenter la taille de title de 25 à 50 caractères
ALTER TABLE Books MODIFY title VARCHAR(50) NOT NULL;

-- 4. Changer publicationDate de DATE à DATETIME
ALTER TABLE Books MODIFY publicationDate DATETIME;

-- 5. Créer la table BookCategories
CREATE TABLE BookCategories (
  categoryID INT AUTO_INCREMENT PRIMARY KEY,
  categoryName VARCHAR(100)
);

-- 6. Ajouter categoryID à Books comme clé étrangère
ALTER TABLE Books ADD COLUMN categoryID INT;
ALTER TABLE Books ADD CONSTRAINT fk_books_category 
  FOREIGN KEY (categoryID) REFERENCES BookCategories(categoryID);

-- 7. Ajouter une valeur par défaut (3) à rating
ALTER TABLE Books ALTER rating SET DEFAULT 3;

-- 8. Supprimer la table Publishers (après avoir retiré la FK)
ALTER TABLE Books DROP FOREIGN KEY fk_books_publisher;
DROP TABLE Publishers;

-- 9. Renommer BookLoans en Loans
RENAME TABLE BookLoans TO Loans;

-- 10. Supprimer memberID de Members
--     a) On retire d’abord la FK de Loans qui référence Members
ALTER TABLE Loans DROP FOREIGN KEY fk_bookloans_member;
--     b) On supprime la clé primaire de Members
ALTER TABLE Members DROP PRIMARY KEY;
--     c) On supprime la colonne memberID
ALTER TABLE Members DROP COLUMN memberID;

