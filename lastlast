-- ============================================================
-- 1) TEST CASCADE
-- ============================================================
ALTER TABLE Books DROP FOREIGN KEY fk_books_publisher;
ALTER TABLE Books ADD CONSTRAINT fk_books_publisher 
  FOREIGN KEY (publisher) REFERENCES Publishers(publisherID) 
  ON DELETE CASCADE ON UPDATE CASCADE;

-- 1.a) DELETE publisher 3
DELETE FROM Publishers WHERE publisherID = 3;
SELECT * FROM Books;
-- Commentaire : le livre "The Hobbit" (publisher 3) est supprimé par cascade.

-- Restauration
INSERT INTO Publishers VALUES (3, 'Houghton Mifflin Harcourt', 'Boston, MA', 1832, 'https://www.hmhbooks.com/');
INSERT INTO Books VALUES ('97805479', 'The Hobbit', 3, '1937-09-21', 'Fantasy');

-- 1.b) UPDATE publisher 4 -> 3
-- On supprime publisher 3 pour éviter un doublon de clé primaire
UPDATE Books SET publisher = NULL WHERE publisher = 3;
DELETE FROM Publishers WHERE publisherID = 3;
UPDATE Publishers SET publisherID = 3 WHERE publisherID = 4;
SELECT * FROM Books;
-- Commentaire : le livre "The Midnight Library" voit son publisher passer de 4 à 3 (cascade).

-- Restauration
UPDATE Books SET publisher = 4 WHERE ISBN = '97803584';
UPDATE Publishers SET publisherID = 4 WHERE publisherID = 3;
INSERT INTO Publishers VALUES (3, 'Houghton Mifflin Harcourt', 'Boston, MA', 1832, 'https://www.hmhbooks.com/');
UPDATE Books SET publisher = 3 WHERE ISBN = '97805479';

-- ============================================================
-- 2) TEST RESTRICT
-- ============================================================
ALTER TABLE Books DROP FOREIGN KEY fk_books_publisher;
ALTER TABLE Books ADD CONSTRAINT fk_books_publisher 
  FOREIGN KEY (publisher) REFERENCES Publishers(publisherID) 
  ON DELETE RESTRICT ON UPDATE RESTRICT;

-- 2.a) DELETE publisher 3
DELETE FROM Publishers WHERE publisherID = 3;
-- Commentaire : ERREUR - suppression refusée car des livres référencent encore publisher 3.

-- 2.b) UPDATE publisher 4 -> 3
UPDATE Publishers SET publisherID = 3 WHERE publisherID = 4;
-- Commentaire : ERREUR - mise à jour refusée car le livre "The Midnight Library" référence publisher 4.

-- ============================================================
-- 3) TEST SET NULL
-- ============================================================
ALTER TABLE Books DROP FOREIGN KEY fk_books_publisher;
ALTER TABLE Books ADD CONSTRAINT fk_books_publisher 
  FOREIGN KEY (publisher) REFERENCES Publishers(publisherID) 
  ON DELETE SET NULL ON UPDATE SET NULL;

-- 3.a) DELETE publisher 3
DELETE FROM Publishers WHERE publisherID = 3;
SELECT * FROM Books;
-- Commentaire : le livre "The Hobbit" a maintenant publisher = NULL.

-- Restauration
INSERT INTO Publishers VALUES (3, 'Houghton Mifflin Harcourt', 'Boston, MA', 1832, 'https://www.hmhbooks.com/');
UPDATE Books SET publisher = 3 WHERE ISBN = '97805479';

-- 3.b) UPDATE publisher 4 -> 3
UPDATE Books SET publisher = NULL WHERE publisher = 3;
DELETE FROM Publishers WHERE publisherID = 3;
UPDATE Publishers SET publisherID = 3 WHERE publisherID = 4;
SELECT * FROM Books;
-- Commentaire : "The Midnight Library" a publisher = NULL suite à la mise à jour.

-- Restauration
UPDATE Books SET publisher = 4 WHERE ISBN = '97803584';
UPDATE Publishers SET publisherID = 4 WHERE publisherID = 3;
INSERT INTO Publishers VALUES (3, 'Houghton Mifflin Harcourt', 'Boston, MA', 1832, 'https://www.hmhbooks.com/');
UPDATE Books SET publisher = 3 WHERE ISBN = '97805479';

-- ============================================================
-- 4) TEST NO ACTION
-- ============================================================
ALTER TABLE Books DROP FOREIGN KEY fk_books_publisher;
ALTER TABLE Books ADD CONSTRAINT fk_books_publisher 
  FOREIGN KEY (publisher) REFERENCES Publishers(publisherID) 
  ON DELETE NO ACTION ON UPDATE NO ACTION;

-- 4.a) DELETE publisher 3
DELETE FROM Publishers WHERE publisherID = 3;
-- Commentaire : ERREUR - même comportement que RESTRICT.

-- 4.b) UPDATE publisher 4 -> 3
UPDATE Publishers SET publisherID = 3 WHERE publisherID = 4;
-- Commentaire : ERREUR - même comportement que RESTRICT.

