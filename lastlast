DROP DATABASE IF EXISTS My_first_library_database;
CREATE DATABASE My_first_library_database;
USE My_first_library_database;

-- Tables nécessaires pour la Partie IV
CREATE TABLE Publishers (
  publisherID INT PRIMARY KEY,
  publisherName VARCHAR(100) NOT NULL,
  headquartersLocation VARCHAR(100),
  foundationYear INT,
  website VARCHAR(200) UNIQUE
);

CREATE TABLE Books (
  ISBN VARCHAR(20) PRIMARY KEY,
  title VARCHAR(50) NOT NULL,
  publisher INT,
  publicationDate DATE,
  genre VARCHAR(50),
  CONSTRAINT fk_books_publisher FOREIGN KEY (publisher) REFERENCES Publishers(publisherID)
);

