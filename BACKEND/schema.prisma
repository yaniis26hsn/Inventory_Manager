
datasource db{
    provider = "mysql"
    url = env()
}
generator client {
    provider = "prisma-client-js"
}

enum Role {
  admin
  worker
  provider

}
enum Category {
    food
  beverage
  electronics
  clothing
  household
  beauty
  office
  hardware
  pet
  other
}
model User {
 idU Int @id @default(autoincrement())
 age  Int
 lname String 
 fname String 
 password  String 
 username String @unique
 role  Role 

}

model Provide {
    idProvide Int @id @default(autoincrement())
    total Float 
    created_at DateTime @default(now())
    ProviderId Int 
    user User @relation(fields:[ProviderId],references: [idU])
}

model Product {
    idP Int @id @default(autoincrement())
    name String
    quantity Int
    minQuantity Int
    price Int
    cost Int
    barcode String
    category Category @unique

}

model Transaction {
idTransaction Int @id @default(autoincrement())
total Float 
created_at DateTime @default(now())
workerId Int 
user User @relation(fields:[workerId],references: [idU])

}
model TransactionItem {
   productId Int 
   product Product @relation(fields:[productId],references: [idP])
   transactionId Int 
   transaction Transaction @relation(fields:[transactionId],references:[idTransaction])

   quantity Int 
   unitPrice Int 
}
model ProvideItem {
    productId Int 
    product Product @relation(fields:[productId],references: [idP])
    provideId Int 
    provide Provide @relation(fields:[provideId],references: [idProvide])

    quantity Int 
    unitPrice Int 
}