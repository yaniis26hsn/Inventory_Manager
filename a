#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ==========================================
// EXERCICE 1 : Moyenne des paramètres
// ==========================================
// Exemple d'exécution : ./moyenne 1 2 45 4
void exercice1(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: %s <nombres...>\n", argv[0]);
        return;
    }

    double somme = 0;
    int nombre_elements = argc - 1; // On exclut le nom du programme (argv[0])

    // On parcourt les arguments à partir de l'indice 1
    for (int i = 1; i < argc; i++) {
        // atof convertit une chaîne de caractères en double
        somme += atof(argv[i]); 
    }

    if (nombre_elements > 0) {
        double moyenne = somme / nombre_elements;
        printf("La moyenne est : %f\n", moyenne);
    }
}


// ==========================================
// EXERCICE 2 : Affichage caractère par caractère
// ==========================================
// Exemple d'exécution : ./afficher ICS
void exercice2(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: %s <chaine>\n", argv[0]);
        return;
    }

    char *chaine = argv[1];
    int longueur = strlen(chaine);

    // Ouverture du fichier en écriture (le fichier sera créé ou écrasé)
    FILE *fichier = fopen("sortie.txt", "w");
    if (fichier == NULL) {
        perror("Erreur lors de l'ouverture du fichier");
        return;
    }

    // Affichage sur l'écran et écriture dans le fichier
    for (int i = 0; i < longueur; i++) {
        printf("%c\n", chaine[i]);      // Affiche à l'écran
        fprintf(fichier, "%c\n", chaine[i]); // Écrit dans le fichier
    }

    fclose(fichier);
}


